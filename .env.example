# OIDASHEIM BEAT SYNC — Environment Configuration
# Copy to .env and customize for your setup

# ══════════════════════════════════════════════════════════════════════════════
# PROJECT PATHS
# ══════════════════════════════════════════════════════════════════════════════
OIDASHEIM_ROOT=J:\Oidasheim\oefoef
OIDASHEIM_MP3_ROOT=J:\Oidasheim\Musik\FAVs
OIDASHEIM_CLIP_POOL=J:\raw_vidz\_raw_reorga__

# ══════════════════════════════════════════════════════════════════════════════
# RENDERING OPTIONS
# ══════════════════════════════════════════════════════════════════════════════
OUTPUT_FPS=30
OUTPUT_RESOLUTION_W=1920
OUTPUT_RESOLUTION_H=1080
VIDEO_CODEC=libx264
CRF=18
USE_NVENC=true

# ══════════════════════════════════════════════════════════════════════════════
# PROCESSING PARAMETERS
# ══════════════════════════════════════════════════════════════════════════════
MIN_SEGMENT_SEC=0.35
MAX_SEGMENT_SEC=3.5
SECTION_SMOOTH_SEC=4.0
NO_REPEAT_WINDOW=12
MAX_CLIP_USES=3
SEMANTIC_WEIGHT=0.6

# ══════════════════════════════════════════════════════════════════════════════
# DEBUG & LOGGING
# ══════════════════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO
DEBUG_MODE=false
DRY_RUN=false

# ══════════════════════════════════════════════════════════════════════════════
# API & EXTERNAL SERVICES (Optional)
# ══════════════════════════════════════════════════════════════════════════════
# DISCORD_WEBHOOK_OIDA=https://discord.com/api/webhooks/1551732581471621122/...
# DISCORD_WEBHOOK_WONG=https://discord.com/api/webhooks/1550973113100140687/...
# OPENAI_API_KEY=sk-...
# WEB3_PROVIDER_URL=https://...

# ══════════════════════════════════════════════════════════════════════════════
# PERFORMANCE TUNING
# ══════════════════════════════════════════════════════════════════════════════
NUM_WORKERS=4
BATCH_SIZE=32
DEVICE=cuda  # or 'cpu' for CPU-only mode
